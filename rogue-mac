#!/bin/sh
# Rogue for macOS - terminal launcher (0.3.27)
# Shell-only interface; game files stay in the same directories as the GUI launcher.

VERSION=0.3.27
BASE_DIR="${HOME:?HOME must be set}/Library/Application Support/Rogue"
# Both the AppleScript GUI and this launcher use NSUserDefaults suite
# "com.leopard.rogue". The defaults utility shares its preference domain.
DEFAULTS_DOMAIN=com.leopard.rogue
# All saved options use the AppleScript-shared domain. No CUI-specific store.
DEFAULTS_CMD=$(command -v defaults 2>/dev/null || :)
PLAYER_NAME=
PLAYER_FRUIT=''
GAME_ROGUEOPTS=''
# Tracked until the input editor's result has been read and removed.
INPUT_TMP=''
# Read only the user's registered login-shell startup environment, as in the GUI.
# Never use the process-inherited ROGUEOPTS as a fallback.
EXTERNAL_INITIAL_ROGUEOPTS=''
EXTERNAL_ROGUEOPTS=''
EXTERNAL_EDITED_IDS=''
PROFILE_EDITED=0
LAST_ID=54
S_MODE= S_LANGUAGE= S_COLOR= S_IDSCRL= S_TERSE= S_PASSGO= S_JUMP= S_ASKME= S_MAPCHARS= S_COMMANDS= S_MACRO=
# Snapshot of effective values at the most recent load/commit. Saving a single
# option must not overwrite another launcher's unrelated preference changes.
BASE_MODE= BASE_LANGUAGE= BASE_COLOR= BASE_IDSCRL= BASE_TERSE= BASE_PASSGO= BASE_JUMP= BASE_ASKME= BASE_MAPCHARS= BASE_COMMANDS= BASE_MACRO=
UI_MONO=0
COLORS=0
GOLD='' TITLE='' TEXT='' DIM='' SAVE_COLOR='' RST=''
[ -n "${NO_COLOR:-}" ] && UI_MONO=1

case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in
    ja*|JA*) LANG_JA=1 ;;
    *)       LANG_JA=0 ;;
esac

usage() {
    cat <<'EOF'
Rogue for macOS

Usage: rogue-mac [54|clone|dos|36|52|34] [game-arguments...]
       rogue-mac --list
       rogue-mac --mono
       rogue-mac --show-rogueopts
       rogue-mac --help

Launch from the version menu, or select a game directly.
When a default saved game exists, choose Resume, New, another File, or Back.
After the game ends, choose Play again, Menu, or Quit.
Return selects the last version chosen by either launcher.
P edits the shared player name/fruit; S edits per-version game settings.
Within S, A opens advanced game options, using GUI-shared values where available.
Saved additional options are applied to newly started games.
DOS Tribute macros are limited to 40 bytes (and cannot contain the x trigger).
The login-shell ROGUEOPTS is read at startup and refreshed before games.
--show-rogueopts displays the freshly read login-shell setting without launching a game.
G opens a version-specific online guide in your default web browser.
The menu follows the AppleScript GUI preferences in com.leopard.rogue.
Game arguments are passed directly to the selected Rogue executable.

The launcher uses the same directories as the Rogue for macOS GUI:
  ~/Library/Application Support/Rogue/{5.4,Clone III,DOS 1.48,3.6,5.2,3.4}/
EOF
}

list_versions() {
    printf '1. Rogue 5.4\n'
    printf '2. Rogue Clone III\n'
    printf '3. Rogue DOS Tribute\n'
    printf '4. Rogue 3.6\n'
    printf '5. Rogue 5.2\n'
    printf '6. Rogue 3.4\n'
}

resolve_version() {
    case "$1" in
        1|54|5.4|5.4.5|rogue54) GAME_ID=54 ;;
        2|clone|c3|clone3|rogue-c3|"Clone III") GAME_ID=clone ;;
        3|dos|dos148|rogue-dos|"DOS Tribute"|"DOS 1.48風") GAME_ID=dos ;;
        4|36|3.6|rogue36) GAME_ID=36 ;;
        5|52|5.2|rogue52) GAME_ID=52 ;;
        6|34|3.4|rogue34|"Rogue 3.4") GAME_ID=34 ;;
        *) return 1 ;;
    esac
    return 0
}

# The version-to-preference namespace is shared by language selection,
# ordinary settings, and the additional-options menu. Keep the mapping in
# one place so new versions cannot accidentally read a different namespace.
version_settings_prefix() {
    case "$1" in
        54) printf 'SavedVersion54' ;;
        clone) printf 'SavedVersionCloneIII' ;;
        dos) printf 'SavedVersionDOS148' ;;
        36) printf 'SavedVersion36' ;;
        52) printf 'SavedVersion52' ;;
        34) printf 'SavedVersion34' ;;
        *) return 1 ;;
    esac
}
setup_game() {
    case "$GAME_ID" in
        54)
            GAME_TITLE='Rogue 5.4'
            GAME_BIN=rogue54
            GAME_DIR=$BASE_DIR/5.4
            GUI_VERSION='5.4'
            SAVE_FILE=rogue.save ;;
        clone)
            GAME_TITLE='Rogue Clone III'
            GAME_BIN=rogue-c3
            GAME_DIR=$BASE_DIR/Clone\ III
            GUI_VERSION='Clone III'
            SAVE_FILE=rogue-clone.save ;;
        dos)
            GAME_TITLE='Rogue DOS Tribute'
            GAME_BIN=rogue-dos
            GAME_DIR=$BASE_DIR/DOS\ 1.48
            GUI_VERSION='DOS Tribute'
            SAVE_FILE=rogue-dos.save ;;
        36)
            GAME_TITLE='Rogue 3.6'
            GAME_BIN=rogue36
            GAME_DIR=$BASE_DIR/3.6
            GUI_VERSION='3.6'
            SAVE_FILE=rogue36.save ;;
        52)
            GAME_TITLE='Rogue 5.2'
            GAME_BIN=rogue52
            GAME_DIR=$BASE_DIR/5.2
            GUI_VERSION='5.2'
            SAVE_FILE=rogue52.save ;;
        34)
            GAME_TITLE='Rogue 3.4'
            GAME_BIN=rogue34
            GAME_DIR=$BASE_DIR/3.4
            GUI_VERSION='3.4'
            SAVE_FILE=rogue34.save ;;
        *) return 1 ;;
    esac
    SETTINGS_PREFIX=$(version_settings_prefix "$GAME_ID") || return 1
}

read_selection() {
    # Use canonical terminal input (Return confirms), so terminal settings need no changes.
    IFS= read -r ANSWER || return 1
    return 0
}

# These checks are shared by screen painting, color setup and normal reset.
# Reading the tty size never consumes keyboard input or changes its modes.
terminal_has_ansi() {
    [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]
}
terminal_size() {
    tty_size=$(stty size 2>/dev/null) || tty_size=''
    tty_size_rows=${tty_size%% *}
    tty_size_cols=${tty_size#* }
}

# Use the same UTF-8 line editor for every editable preference and path.
# This helper only chooses the message; input validation remains with callers.
read_named_text() {
    case "$1:$LANG_JA" in
        value:1) text_prompt='新しい値（空欄でキャンセル）› ' ;;
        value:0) text_prompt='New value (blank cancels) › ' ;;
        name:1) text_prompt='新しいプレイヤー名（空欄で変更せず戻る）: ' ;;
        name:0) text_prompt='New player name (blank to cancel): ' ;;
        fruit:1) text_prompt='好きな果物の名前（空欄で変更せず戻る）: ' ;;
        fruit:0) text_prompt='Favorite fruit (blank to cancel): ' ;;
        path:1) text_prompt='セーブファイルのパス（空欄で戻る）: ' ;;
        path:0) text_prompt='Path to saved game (blank to cancel): ' ;;
        *) return 1 ;;
    esac
    read_text_input "$text_prompt"
}

# Menu keys keep the traditional canonical input. For editable UTF-8
# strings, use a dedicated line editor: macOS Terminal's canonical erase
# handling can remove a UTF-8 byte at a time and echo arrow escape codes.
# This editor removes whole grapheme clusters (including Japanese and emoji),
# supports Left/Right/Home/End/Delete and Ctrl-U, and restores terminal modes
# even on SIGINT/TERM/HUP. Its Perl dependencies are included with macOS.
# The editor runs in the foreground, never in command substitution: otherwise
# reading /dev/tty could trigger SIGTTIN under zsh job control.
read_text_input() {
    line_prompt=$1
    if [ ! -t 0 ] || [ ! -t 1 ] || ! command -v perl >/dev/null 2>&1; then
        printf '%s' "$line_prompt"
        read_selection
        return $?
    fi
    line_tmp=$(mktemp "${TMPDIR:-/tmp}/rogue-mac-input.XXXXXX") || {
        printf '%s' "$line_prompt"
        read_selection
        return $?
    }
    # The EXIT trap also removes this file if the shell is interrupted.
    INPUT_TMP=$line_tmp
    terminal_size
    line_cols=$tty_size_cols
    case "$line_cols" in ''|*[!0-9]*) line_cols=80 ;; esac
    perl - "$line_prompt" "$line_cols" >"$line_tmp" <<'ROGUE_MAC_LINE_EDITOR'
# Edit UTF-8 text by Unicode grapheme clusters; no non-core Perl modules.
use strict;
use warnings;
use POSIX qw(TCSANOW ICANON ECHO VMIN VTIME);
use Encode qw(decode encode FB_CROAK);

my $prompt = eval { decode(q(UTF-8), shift(@ARGV) // q(), FB_CROAK) } // q();
my $columns = shift(@ARGV) || 80;
$columns = 80 if $columns !~ /\A\d+\z/ || $columns < 20 || $columns > 500;
open my $tty, q(+<), q(/dev/tty) or exit 2;
binmode($tty, q(:raw));
binmode(STDOUT, q(:raw));
my $fd = fileno($tty);
my $old = POSIX::Termios->new();
$old->getattr($fd) or exit 2;
my $now = POSIX::Termios->new();
$now->getattr($fd) or exit 2;
$now->setlflag($now->getlflag() & ~(ICANON | ECHO));
$now->setcc(VMIN, 1);
$now->setcc(VTIME, 0);
$now->setattr($fd, TCSANOW) or exit 2;
my $restore = sub { $old->setattr($fd, TCSANOW); };
END { $restore->() if $restore; }
$SIG{INT} = sub { exit 130; };
$SIG{TERM} = sub { exit 143; };
$SIG{HUP} = sub { exit 129; };

sub width {
    my ($g) = @_;
    return 0 if $g !~ /\P{Grapheme_Extend}/;
    return 2 if $g =~ /\p{East_Asian_Width=Wide}|\p{East_Asian_Width=Fullwidth}|\p{Emoji_Presentation}|\p{Regional_Indicator}|\x{FE0F}/;
    return 1;
}
sub string_width {
    my ($s) = @_;
    my $w = 0;
    $w += width($_) for $s =~ /\X/g;
    return $w;
}
sub put_tty {
    my ($s) = @_;
    my $data = encode(q(UTF-8), $s);
    my $total = length($data);
    my $off = 0;
    while ($off < $total) {
        my $n = syswrite($tty, $data, $total - $off, $off);
        last if !defined $n || !$n;
        $off += $n;
    }
}
my @cells;
my $cursor = 0;
my $view_start = 0;
sub render {
    my $available = $columns - string_width($prompt) - 1;
    $available = 5 if $available < 5;
    $view_start = $cursor if $cursor < $view_start;
    my $cw = 0;
    $cw += width($cells[$_]) for $view_start .. $cursor - 1;
    while ($cw > $available && $view_start < $cursor) {
        $cw -= width($cells[$view_start++]);
    }
    my $display = q();
    my $used = 0;
    for my $i ($view_start .. $#cells) {
        my $w = width($cells[$i]);
        last if $used + $w > $available;
        $display .= $cells[$i];
        $used += $w;
    }
    put_tty("\r\e[2K" . $prompt . $display);
    my $back = $used - $cw;
    put_tty("\e[${back}D") if $back > 0;
}
sub read_byte {
    my ($time) = @_;
    if (defined $time) {
        my $rin = q();
        vec($rin, $fd, 1) = 1;
        my $count = select($rin, undef, undef, $time);
        return undef if !$count;
    }
    my $b = q();
    my $n = sysread($tty, $b, 1);
    return undef if !defined $n || $n == 0;
    return ord($b);
}
sub apply_edit_action {
    my ($action) = @_;
    if ($action eq q(clear)) {
        @cells = (); $cursor = 0; $view_start = 0;
    } elsif ($action eq q(home)) {
        $cursor = 0;
    } elsif ($action eq q(end)) {
        $cursor = scalar(@cells);
    } elsif ($action eq q(left)) {
        $cursor-- if $cursor > 0;
    } elsif ($action eq q(right)) {
        $cursor++ if $cursor < @cells;
    } elsif ($action eq q(backspace)) {
        splice(@cells, --$cursor, 1) if $cursor > 0;
    } elsif ($action eq q(delete)) {
        splice(@cells, $cursor, 1) if $cursor < @cells;
    }
    render();
}
sub insert_char {
    my ($c) = @_;
    my $before = $cursor ? join(q(), @cells[0 .. $cursor - 1]) : q();
    my $after = $cursor <= $#cells ? join(q(), @cells[$cursor .. $#cells]) : q();
    my $new = $before . $c . $after;
    # Prevent unbounded line-editor memory use. Game-specific lower limits
    # are validated by the existing caller after Return.
    return if length(encode(q(UTF-8), $new)) > 4096;
    @cells = ($new =~ /\X/g);
    my $length_before = length($before . $c);
    $cursor = 0;
    my $count_chars = 0;
    for my $g (@cells) {
        last if $count_chars >= $length_before;
        $count_chars += length($g);
        $cursor++;
    }
}
render();
while (1) {
    my $b = read_byte(undef);
    last if !defined $b;
    if ($b == 13 || $b == 10) {
        put_tty("\r\n");
        print STDOUT encode(q(UTF-8), join(q(), @cells));
        exit 0;
    }
    if ($b == 4 && !@cells) { put_tty("\r\n"); exit 1; }
    if ($b == 21) { apply_edit_action(q(clear)); next; }
    if ($b == 1) { apply_edit_action(q(home)); next; }
    if ($b == 5) { apply_edit_action(q(end)); next; }
    if ($b == 8 || $b == 127) { apply_edit_action(q(backspace)); next; }
    if ($b == 27) {
        my $b2 = read_byte(.08);
        if (!defined $b2) { put_tty("\r\n"); exit 0; }
        if ($b2 == 91 || $b2 == 79) {
            my $seq = q();
            for (1 .. 16) {
                my $next = read_byte(.08);
                last if !defined $next;
                $seq .= chr($next);
                last if $next >= 64 && $next <= 126;
            }
            my $action = q();
            if ($seq =~ /\A[0-9;]*D\z/) { $action = q(left); }
            elsif ($seq =~ /\A[0-9;]*C\z/) { $action = q(right); }
            elsif ($seq =~ /\A(?:[0-9;]*H|1~|7~)\z/) { $action = q(home); }
            elsif ($seq =~ /\A(?:[0-9;]*F|4~|8~)\z/) { $action = q(end); }
            elsif ($seq eq q(3~)) { $action = q(delete); }
            apply_edit_action($action);
        }
        next;
    }
    next if $b < 32;
    if ($b < 128) { insert_char(chr($b)); render(); next; }
    my $expected = ($b & 0xE0) == 0xC0 ? 2 : ($b & 0xF0) == 0xE0 ? 3 : ($b & 0xF8) == 0xF0 ? 4 : 0;
    next if !$expected;
    my $bytes = pack(q(C), $b);
    for (2 .. $expected) {
        my $next = read_byte(.5);
        last if !defined $next;
        $bytes .= pack(q(C), $next);
    }
    my $char = eval { decode(q(UTF-8), $bytes, FB_CROAK) };
    if (defined $char && $char !~ /\p{Cc}/) { insert_char($char); render(); }
}
put_tty("\r\n");
exit 1;
ROGUE_MAC_LINE_EDITOR
    line_status=$?
    if [ "$line_status" -eq 0 ]; then
        if ! ANSWER=$(cat "$line_tmp"); then
            ANSWER=''
            line_status=1
        fi
    else
        ANSWER=''
    fi
    rm -f "$line_tmp"
    INPUT_TMP=''
    # A signal received by the editor should end the launcher as well;
    # returning to its menu would treat the interruption as cancellation.
    case "$line_status" in 129|130|131|143) exit "$line_status" ;; esac
    return "$line_status"
}

# Paint the entire terminal grid while keeping the user's Terminal background.
# Use SGR 49 (default background), never force black with SGR 40.
# Screen dimensions are read without consuming input or changing tty modes.
clear_screen() {
    if terminal_has_ansi; then
        if [ "$COLORS" -eq 1 ]; then
            terminal_size
            screen_rows=$tty_size_rows
            screen_cols=$tty_size_cols
            case "$screen_rows:$screen_cols" in
                *[!0-9:]*|:*|*:|:) screen_rows=24; screen_cols=80 ;;
            esac
            if [ "$screen_rows" -lt 1 ] || [ "$screen_cols" -lt 1 ] ||
               [ "$screen_rows" -gt 300 ] || [ "$screen_cols" -gt 500 ]; then
                screen_rows=24; screen_cols=80
            fi
            printf '%s\033[2J\033[H' "$RST"
            screen_row=1
            while [ "$screen_row" -le "$screen_rows" ]; do
                printf '\033[%d;1H%*s' "$screen_row" "$screen_cols" ''
                screen_row=$((screen_row + 1))
            done
            printf '\033[H'
        else
            # --mono intentionally keeps the terminal's own colors.
            printf '\033[0m\033[2J\033[H'
        fi
    fi
}

# Leave terminal colors and background untouched when Rogue takes over and
# when printing the farewell. Never leave painted black cells behind on exit.
clear_terminal_screen() {
    reset_screen_colors
    if terminal_has_ansi; then
        printf '\033[2J\033[H'
    fi
}

init_colors() {
    COLORS=0 GOLD='' TITLE='' TEXT='' DIM='' SAVE_COLOR='' RST=''
    if [ "$UI_MONO" -eq 0 ] && terminal_has_ansi; then
        COLORS=1
        # Match the Terminal profile's exact background, including dark gray.
        # SGR 49 avoids the colored-text background looking like black patches.
        RST=$(printf '\033[0;38;5;252;49m')
        GOLD=$(printf '\033[38;5;180m')
        TITLE=$(printf '\033[38;5;223m')
        TEXT=$(printf '\033[38;5;252m')
        DIM=$(printf '\033[38;5;109m')
        SAVE_COLOR=$DIM
    fi
}
reset_screen_colors() {
    # Restore the user's normal foreground/background and other attributes.
    if terminal_has_ansi; then printf '\033[0m'; fi
}
cleanup_launcher() {
    # No normal exit, EOF or trapped signal may leave temporary input behind.
    if [ -n "$INPUT_TMP" ]; then rm -f "$INPUT_TMP" 2>/dev/null || :; fi
    reset_screen_colors
}
line52() {
    i=0
    while [ "$i" -lt 52 ]; do printf '─'; i=$((i+1)); done
}

menu_heading() {
    printf '%s%s%s\n' "$TITLE" "$1" "$RST"
}
menu_numbered_choice() {
    printf '  %s%2s%s  %s\n' "$GOLD" "$1" "$RST" "$2"
}
menu_key_choice() {
    printf '  %s%s%s  %s\n' "$GOLD" "$1" "$RST" "$2"
}
menu_advanced_current() {
    if [ "$LANG_JA" -eq 1 ]; then
        printf '  現在の設定：%s\n\n' "$1"
    else
        printf '  Current setting: %s\n\n' "$1"
    fi
}
# Control characters are not rendered from editable preferences.
clean_text() {
    printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177'
}
read_pref() {
    # Missing preference -> explicit fallback, without modifying the GUI store.
    key=$1 fallback=$2
    if [ -n "$DEFAULTS_CMD" ]; then
        found=$("$DEFAULTS_CMD" read "$DEFAULTS_DOMAIN" "$key" 2>/dev/null) || found=''
        if [ -n "$found" ]; then printf '%s' "$found"; return 0; fi
    fi
    printf '%s' "$fallback"
}
load_last_version() {
    saved=$(read_pref Savedmygameversion '5.4')
    if resolve_version "$saved"; then LAST_ID=$GAME_ID; else LAST_ID=54; fi
}
# AppleScript-compatible ROGUEOPTS retrieval from the account's login shell.
# dscl provides UserShell; env -u removes a potentially stale inherited value.
# GUI AppleScript runs its login-shell probe without a controlling terminal.
# A terminal launcher must explicitly do the same: an interactive zsh -lic
# can otherwise seize the foreground terminal process group and leave this
# launcher stopped by SIGTTIN ("zsh: suspended (tty input) ./rogue-mac").
# setsid() plus /dev/null stdin keeps the probe completely off the user's TTY.
# A 5-second Perl alarm covers shell initialization hooks that might hang.
# Markers isolate the value from banners or commands printed by the shell.
read_external_rogueopts() {
    [ -x /usr/bin/dscl ] && [ -x /usr/bin/perl ] && [ -x /usr/bin/env ] || return 0
    ex_user=$(/usr/bin/id -un 2>/dev/null) || return 0
    ex_login_shell=$(/usr/bin/dscl . -read "/Users/$ex_user" UserShell 2>/dev/null | /usr/bin/awk '$1 == "UserShell:" { print $2; exit }')
    case "$ex_login_shell" in /*) [ -x "$ex_login_shell" ] || return 0 ;; *) return 0 ;; esac
    ex_begin='__ROGUEOPTS_CUI_BEGIN_83619__'
    ex_end='__ROGUEOPTS_CUI_END_83619__'
    ex_probe='/usr/bin/perl -e '\''print "\n__ROGUEOPTS_CUI_BEGIN_83619__\n"; print defined($ENV{ROGUEOPTS}) ? $ENV{ROGUEOPTS} : ""; print "\n__ROGUEOPTS_CUI_END_83619__\n"; '\'''
    # Fork first: a command-substitution process may be a process-group leader,
    # and setsid() fails in a group leader.  A fresh forked child never is one.
    # Only the detached child runs the interactive login shell; the parent
    # enforces the deadline, including shells that refuse EOF on /dev/null.
    ex_result=$(/usr/bin/perl -MPOSIX=setsid -e '
        my $pid = fork(); defined($pid) or exit 1;
        if ($pid == 0) {
            setsid() >= 0 or exit 1;
            open(STDIN, "<", "/dev/null") or exit 1;
            exec @ARGV;
            exit 1;
        }
        $SIG{ALRM} = sub { kill "KILL", -$pid; kill "KILL", $pid; exit 1; };
        alarm 5;
        waitpid($pid, 0);
        my $status = $?;
        alarm 0;
        exit(($status == 0) ? 0 : 1);
    ' /usr/bin/env -u ROGUEOPTS "$ex_login_shell" -lic "$ex_probe" </dev/null 2>/dev/null) || return 0
    case "$ex_result" in *"$ex_begin"*"$ex_end"*) : ;; *) return 0 ;; esac
    ex_result=${ex_result#*"$ex_begin"}
    ex_result=${ex_result#?} # remove the marker's newline
    ex_result=${ex_result%%"$ex_end"*}
    ex_result=${ex_result%?} # remove newline before closing marker
    # Newlines and control bytes cannot be safe comma-separated ROGUEOPTS.
    case "$ex_result" in *'
'*|*'
'*) return 0 ;; esac
    printf '%s' "$ex_result"
}

# Resolve complete names and unambiguous historical abbreviations.  Unknown
# options remain opaque and may pass through to their original game parser.
external_option_key() {
    ex_key_raw=$(printf '%s' "${1%%=*}" | LC_ALL=C tr '[:upper:]' '[:lower:]')
    ex_key_candidate=$ex_key_raw
    case "$ex_key_candidate" in
        noaskquit|noskull|notomb) printf '%s' "$ex_key_candidate"; return ;;
        no*) ex_key_candidate=${ex_key_candidate#no} ;;
    esac
    case "$ex_key_candidate" in
        color|cursor|idscrl|terse|passgo|jump|askme|extchars|monster|macro|doskeys|name|fruit|language|file|flush|step|seefloor|tombstone|inven|menu)
            printf '%s' "$ex_key_candidate"; return ;;
    esac
    [ "${#ex_key_candidate}" -ge 2 ] || { printf '%s' "$ex_key_raw"; return; }
    ex_key_hits=0 ex_key_found=''
    for ex_key_known in color cursor idscrl terse passgo jump askme extchars monster macro doskeys name fruit language file flush step seefloor tombstone inven menu; do
        case "$ex_key_known" in
            "$ex_key_candidate"*) ex_key_hits=$((ex_key_hits+1)); ex_key_found=$ex_key_known ;;
        esac
    done
    if [ "$ex_key_hits" -eq 1 ]; then printf '%s' "$ex_key_found"; else printf '%s' "$ex_key_raw"; fi
}
external_option_off() {
    case "${1%%=*}" in no*) return 0 ;; *) return 1 ;; esac
}
external_option_value() {
    case "$1" in *=*) printf '%s' "${1#*=}" ;; *) printf '' ;; esac
}

# Read the next comma-delimited ROGUEOPTS entry.  The caller owns the rest
# of its string, so a nested option lookup cannot consume another scan.
# Empty fields are skipped by the individual callers as before.
next_rogueopts_item() {
    [ -n "$1" ] || return 1
    case "$1" in
        *,*) ROGUEOPTS_ITEM=${1%%,*}; ROGUEOPTS_REST=${1#*,} ;;
        *) ROGUEOPTS_ITEM=$1; ROGUEOPTS_REST='' ;;
    esac
    ROGUEOPTS_ITEM=$(printf '%s' "$ROGUEOPTS_ITEM" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    return 0
}

# 5.4's inventory parser accepts names in the *current game language*.
# Normalize the historical English/Japanese spellings once for both the
# external-option inspector and the new-game environment builder.
inventory_mode_from_value() {
    case "$1" in
        [Oo]*|上書き*) printf 'Overwrite' ;;
        [Ss]*|低速*) printf 'Slow' ;;
        [Cc]*|クリア*) printf 'Clear' ;;
    esac
}
inventory_mode_for_game() {
    if [ "$S_LANGUAGE" = English ]; then
        printf '%s' "$1"
    else
        case "$1" in
            Overwrite) printf '上書き' ;;
            Slow) printf '低速' ;;
            Clear) printf 'クリア' ;;
        esac
    fi
}
external_language_from_initial() {
    ex_l_remaining=$EXTERNAL_INITIAL_ROGUEOPTS
    ex_l_language=''
    while next_rogueopts_item "$ex_l_remaining"; do
        ex_l_remaining=$ROGUEOPTS_REST
        ex_l_item=$ROGUEOPTS_ITEM
        if [ "$(external_option_key "$ex_l_item")" = language ]; then
            case "$(external_option_value "$ex_l_item")" in
                ja|en) ex_l_language=$(external_option_value "$ex_l_item") ;;
            esac
        fi
    done
    printf '%s' "$ex_l_language"
}
version_edited() {
    case " $EXTERNAL_EDITED_IDS " in *" $GAME_ID "*) return 0 ;; *) return 1 ;; esac
}
mark_version_edited() {
    version_edited || EXTERNAL_EDITED_IDS="$EXTERNAL_EDITED_IDS $GAME_ID"
}

# Map only the shared, GUI-editable keys.  No preference is written while
# reading external shell defaults.  Unsupported keys remain pass-through.
apply_external_gui_settings() {
    [ -n "$EXTERNAL_INITIAL_ROGUEOPTS" ] || return 0
    version_edited && return 0
    ex_g_remaining=$EXTERNAL_INITIAL_ROGUEOPTS
    ex_g_changed=0
    while next_rogueopts_item "$ex_g_remaining"; do
        ex_g_remaining=$ROGUEOPTS_REST
        ex_g_item=$ROGUEOPTS_ITEM
        ex_g_key=$(external_option_key "$ex_g_item")
        ex_g_value=$(external_option_value "$ex_g_item")
        if external_option_off "$ex_g_item"; then ex_g_bool=off; else ex_g_bool=on; fi
        ex_g_target=$(advanced_shared_target "$ex_g_key")
        case "$ex_g_target:$ex_g_key" in
            language:language)
                case "$ex_g_value" in
                    ja) S_LANGUAGE='日本語' ;; en) S_LANGUAGE=English ;;
                esac ;;
            color:color)
                if [ "$ex_g_bool" = on ]; then ex_g_next=カラー; else ex_g_next=モノクロ; fi
                [ "$S_COLOR" = "$ex_g_next" ] || { S_COLOR=$ex_g_next; ex_g_changed=1; } ;;
            idscrl:idscrl)
                if [ "$ex_g_bool" = on ]; then ex_g_next='１種類'; else ex_g_next='５種類'; fi
                [ "$S_IDSCRL" = "$ex_g_next" ] || { S_IDSCRL=$ex_g_next; ex_g_changed=1; } ;;
            terse:terse)
                if [ "$ex_g_bool" = on ]; then ex_g_next='短くする'; else ex_g_next=ふつう; fi
                [ "$S_TERSE" = "$ex_g_next" ] || { S_TERSE=$ex_g_next; ex_g_changed=1; } ;;
            passgo:passgo)
                if [ "$ex_g_bool" = on ]; then ex_g_next=止まらない; else ex_g_next=止まる; fi
                [ "$S_PASSGO" = "$ex_g_next" ] || { S_PASSGO=$ex_g_next; ex_g_changed=1; } ;;
            jump:jump)
                if [ "$ex_g_bool" = on ]; then ex_g_next=True; else ex_g_next=False; fi
                [ "$S_JUMP" = "$ex_g_next" ] || { S_JUMP=$ex_g_next; ex_g_changed=1; } ;;
            askme:askme)
                if [ "$ex_g_bool" = on ]; then ex_g_next=True; else ex_g_next=False; fi
                [ "$S_ASKME" = "$ex_g_next" ] || { S_ASKME=$ex_g_next; ex_g_changed=1; } ;;
            mapchars:extchars)
                if [ "$ex_g_bool" = on ]; then ex_g_next=拡張; else ex_g_next=基本; fi
                [ "$S_MAPCHARS" = "$ex_g_next" ] || { S_MAPCHARS=$ex_g_next; ex_g_changed=1; } ;;
            commands:doskeys)
                if [ "$ex_g_bool" = on ]; then ex_g_next='DOS 1.48風'; else ex_g_next='5.4風'; fi
                [ "$S_COMMANDS" = "$ex_g_next" ] || { S_COMMANDS=$ex_g_next; ex_g_changed=1; } ;;
            macro:macro)
                if advanced_validate_text macro "$ex_g_value" && [ "$S_MACRO" != "$ex_g_value" ]; then
                    S_MACRO=$ex_g_value; ex_g_changed=1
                fi ;;
        esac
    done
    [ "$ex_g_changed" -eq 0 ] || S_MODE='細かく設定'
}

# A session's display language is selected explicitly. Unknown/absent
# preferences leave the terminal locale unchanged, as before.
apply_ui_language() {
    case "$1" in
        English) LANG_JA=0 ;;
        日本語) LANG_JA=1 ;;
    esac
}
load_ui_language() {
    # The GUI stores language per version, with a global fallback.
    language_prefix=$(version_settings_prefix "$LAST_ID") || return 1
    fallback=$(read_pref Savedmylanguage '')
    saved=$(read_pref "${language_prefix}_mylanguage" "$fallback")
    apply_ui_language "$saved"
    GAME_ID=$LAST_ID
    if ! version_edited; then
        case "$(external_language_from_initial)" in
            ja) LANG_JA=1 ;; en) LANG_JA=0 ;;
        esac
    fi
}
# Reflect a selection in the GUI. Merely opening the menu never writes settings.
remember_version() {
    setup_game
    write_profile_value Savedmygameversion "$GUI_VERSION" || return 1
    LAST_ID=$GAME_ID
    return 0
}
# The GUI preference suffixes and current shell variables form one schema.
# Never use eval or dynamically named shell variables for preference values:
# this explicit mapping is also safe for arbitrary UTF-8 user strings.
game_setting_suffix() {
    case "$1" in
        mode) printf 'gamemode' ;; language) printf 'mylanguage' ;;
        color) printf 'mycolor' ;; idscrl) printf 'myidscrl' ;;
        terse) printf 'myterse' ;; passgo) printf 'mypassgo' ;;
        jump) printf 'myjump' ;; askme) printf 'myaskme' ;;
        mapchars) printf 'mymapchars' ;; commands) printf 'mycommands' ;;
        macro) printf 'mymacro' ;;
        *) return 1 ;;
    esac
}
game_setting_key() {
    gs_key_suffix=$(game_setting_suffix "$1") || return 1
    printf '%s_%s' "$SETTINGS_PREFIX" "$gs_key_suffix"
}
game_setting_default() {
    case "$1" in
        mode) printf 'モダン' ;;
        language) read_pref Savedmylanguage 日本語 ;;
        color) printf 'カラー' ;;
        idscrl) printf '１種類' ;;
        terse) printf 'ふつう' ;;
        passgo) printf '止まらない' ;;
        jump) case "$GAME_ID" in clone|36|52|34) printf False ;; *) printf True ;; esac ;;
        askme) case "$GAME_ID" in 36|52|34) printf True ;; *) printf False ;; esac ;;
        mapchars) printf '拡張' ;;
        commands) printf '5.4風' ;;
        macro) printf 'v' ;;
        *) return 1 ;;
    esac
}
read_game_setting() {
    gs_read_key=$(game_setting_key "$1") || return 1
    gs_read_default=$(game_setting_default "$1") || return 1
    read_pref "$gs_read_key" "$gs_read_default"
}
game_setting_value() {
    case "$1" in
        mode) printf '%s' "$S_MODE" ;; language) printf '%s' "$S_LANGUAGE" ;;
        color) printf '%s' "$S_COLOR" ;; idscrl) printf '%s' "$S_IDSCRL" ;;
        terse) printf '%s' "$S_TERSE" ;; passgo) printf '%s' "$S_PASSGO" ;;
        jump) printf '%s' "$S_JUMP" ;; askme) printf '%s' "$S_ASKME" ;;
        mapchars) printf '%s' "$S_MAPCHARS" ;; commands) printf '%s' "$S_COMMANDS" ;;
        macro) printf '%s' "$S_MACRO" ;;
        *) return 1 ;;
    esac
}
# Keep a per-version effective-value snapshot, including external shell defaults.
# A value supplied by ROGUEOPTS should not be written just because the user
# subsequently edits some unrelated setting.
capture_game_settings_baseline() {
    BASE_MODE=$S_MODE BASE_LANGUAGE=$S_LANGUAGE BASE_COLOR=$S_COLOR
    BASE_IDSCRL=$S_IDSCRL BASE_TERSE=$S_TERSE BASE_PASSGO=$S_PASSGO
    BASE_JUMP=$S_JUMP BASE_ASKME=$S_ASKME BASE_MAPCHARS=$S_MAPCHARS
    BASE_COMMANDS=$S_COMMANDS BASE_MACRO=$S_MACRO
}
baseline_setting_value() {
    case "$1" in
        mode) printf '%s' "$BASE_MODE" ;; language) printf '%s' "$BASE_LANGUAGE" ;;
        color) printf '%s' "$BASE_COLOR" ;; idscrl) printf '%s' "$BASE_IDSCRL" ;;
        terse) printf '%s' "$BASE_TERSE" ;; passgo) printf '%s' "$BASE_PASSGO" ;;
        jump) printf '%s' "$BASE_JUMP" ;; askme) printf '%s' "$BASE_ASKME" ;;
        mapchars) printf '%s' "$BASE_MAPCHARS" ;; commands) printf '%s' "$BASE_COMMANDS" ;;
        macro) printf '%s' "$BASE_MACRO" ;;
        *) return 1 ;;
    esac
}
update_setting_baseline() {
    case "$1" in
        mode) BASE_MODE=$2 ;; language) BASE_LANGUAGE=$2 ;;
        color) BASE_COLOR=$2 ;; idscrl) BASE_IDSCRL=$2 ;;
        terse) BASE_TERSE=$2 ;; passgo) BASE_PASSGO=$2 ;;
        jump) BASE_JUMP=$2 ;; askme) BASE_ASKME=$2 ;;
        mapchars) BASE_MAPCHARS=$2 ;; commands) BASE_COMMANDS=$2 ;;
        macro) BASE_MACRO=$2 ;;
        *) return 1 ;;
    esac
}

# Validate stored values without writing defaults back to the GUI's domain.
normalize_game_settings() {
    case "$S_MODE" in 'モダン'|'クラシック'|'細かく設定') : ;; *) S_MODE='モダン' ;; esac
    case "$S_LANGUAGE" in English) : ;; *) S_LANGUAGE='日本語' ;; esac
    case "$S_COLOR" in カラー|モノクロ) : ;; *) S_COLOR=カラー ;; esac
    case "$S_IDSCRL" in '１種類'|'５種類') : ;; *) S_IDSCRL='１種類' ;; esac
    case "$S_TERSE" in '短くする'|'ふつう') : ;; *) S_TERSE='ふつう' ;; esac
    case "$S_PASSGO" in '止まらない'|'止まる') : ;; *) S_PASSGO='止まらない' ;; esac
    case "$S_JUMP" in False) : ;; *) S_JUMP=True ;; esac
    case "$S_ASKME" in False) : ;; *) S_ASKME=True ;; esac
    case "$S_MAPCHARS" in '拡張'|'基本') : ;; *) S_MAPCHARS='拡張' ;; esac
    case "$S_COMMANDS" in '5.4風'|'DOS 1.48風') : ;; *) S_COMMANDS='5.4風' ;; esac
    [ -n "$S_MACRO" ] || S_MACRO=v
}
# Read all version settings through the same schema used when saving.
# 3.6 and 5.2 have mode-dependent defaults that the GUI reapplies on load.
load_game_settings() {
    setup_game || return 1
    S_MODE=$(read_game_setting mode)
    S_LANGUAGE=$(read_game_setting language)
    S_COLOR=$(read_game_setting color)
    S_IDSCRL=$(read_game_setting idscrl)
    S_TERSE=$(read_game_setting terse)
    S_PASSGO=$(read_game_setting passgo)
    S_JUMP=$(read_game_setting jump)
    S_ASKME=$(read_game_setting askme)
    S_MAPCHARS=$(read_game_setting mapchars)
    S_COMMANDS=$(read_game_setting commands)
    S_MACRO=$(read_game_setting macro)
    normalize_game_settings
    # Do not overwrite stored values here.
    if [ "$GAME_ID" = 36 ] || [ "$GAME_ID" = 52 ] || [ "$GAME_ID" = 34 ]; then
        case "$S_MODE" in モダン|クラシック) apply_mode_preset ;; esac
    fi
    apply_external_gui_settings
    capture_game_settings_baseline
}
apply_mode_preset() {
    case "$GAME_ID:$S_MODE" in
        54:モダン) S_COLOR=カラー; S_IDSCRL='１種類'; S_TERSE=ふつう; S_PASSGO=止まらない ;;
        54:クラシック) S_COLOR=モノクロ; S_IDSCRL='５種類'; S_TERSE=ふつう; S_PASSGO=止まる ;;
        clone:モダン) S_COLOR=カラー; S_PASSGO=止まらない; S_JUMP=False ;;
        clone:クラシック) S_COLOR=モノクロ; S_PASSGO=止まる; S_JUMP=True ;;
        dos:モダン) S_COLOR=カラー; S_MAPCHARS=拡張; S_COMMANDS='5.4風'; S_MACRO=v; S_TERSE=ふつう ;;
        dos:クラシック) S_COLOR=カラー; S_MAPCHARS=拡張; S_COMMANDS='DOS 1.48風'; S_MACRO=v; S_TERSE=ふつう ;;
        36:モダン) S_TERSE=ふつう; S_JUMP=False; S_ASKME=True ;;
        34:モダン) S_TERSE=ふつう; S_JUMP=False; S_ASKME=True ;;
        36:クラシック) S_TERSE=ふつう; S_JUMP=False; S_ASKME=False ;;
        34:クラシック) S_TERSE=ふつう; S_JUMP=False; S_ASKME=False ;;
        52:モダン) S_COLOR=カラー; S_PASSGO=止まらない; S_TERSE=ふつう; S_JUMP=False; S_ASKME=True ;;
        52:クラシック) S_COLOR=モノクロ; S_PASSGO=止まる; S_TERSE=ふつう; S_JUMP=False; S_ASKME=False ;;
    esac
}
report_partial_settings() {
    # defaults writes individual keys, not an atomic transaction. Say so
    # explicitly rather than suggesting that a failed save rolled everything
    # back; the caller reloads actual stored preferences where appropriate.
    if [ "$LANG_JA" -eq 1 ]; then
        printf '%s\n' '一部の設定だけが保存された可能性があります。' >&2
    else
        printf '%s\n' 'Some settings may already have been saved.' >&2
    fi
}
save_game_settings() {
    # Write only fields changed since load (matching the AppleScript GUI).
    # In particular, selecting one setting or switching modes must not write
    # stale copies of unrelated options that the GUI might have just changed.
    for gs_save_field in mode language color idscrl terse passgo jump askme mapchars commands macro; do
        gs_save_value=$(game_setting_value "$gs_save_field") || return 1
        gs_save_before=$(baseline_setting_value "$gs_save_field") || return 1
        [ "$gs_save_value" != "$gs_save_before" ] || continue
        gs_save_key=$(game_setting_key "$gs_save_field") || return 1
        gs_save_suffix=$(game_setting_suffix "$gs_save_field") || return 1
        if ! write_profile_value "$gs_save_key" "$gs_save_value"; then
            report_partial_settings
            return 1
        fi
        # The GUI also keeps the old, non-versioned fallback in sync, but
        # only for a field the user actually changed.
        if ! write_profile_value "Saved${gs_save_suffix}" "$gs_save_value"; then
            report_partial_settings
            return 1
        fi
        update_setting_baseline "$gs_save_field" "$gs_save_value" || return 1
        mark_version_edited
    done
    return 0
}
# Follow the GUI's translation rule only for built-in fruit names, and only
# when language is actively changed in this launcher.
sync_default_fruit_for_language() {
    fruit=$(read_pref Savedmyfruit '')
    if [ "$S_LANGUAGE" = English ]; then
        case "$fruit" in ネバネバかび|こけもも) write_profile_value Savedmyfruit slime-mold || return 1 ;; esac
    else
        case "$fruit" in slime-mold|こけもも) write_profile_value Savedmyfruit ネバネバかび || return 1 ;; esac
    fi
    return 0
}
# Save and reflect a language change in one place, including the GUI's
# built-in fruit translation. Other setting edits never invoke this helper.
save_language_change() {
    save_game_settings || return 1
    # The language is already committed. Reflect it even if the subsequent
    # best-effort built-in fruit translation cannot be persisted.
    apply_ui_language "$S_LANGUAGE"
    sync_default_fruit_for_language
}
# Which options can be edited for each historical version.
fields_for_version() {
    case "$GAME_ID" in
        54) printf '%s' 'color idscrl terse passgo' ;;
        clone) printf '%s' 'color passgo jump' ;;
        dos) printf '%s' 'color mapchars commands macro terse' ;;
        36) printf '%s' 'terse jump askme' ;;
        34) printf '%s' 'terse jump askme' ;;
        52) printf '%s' 'color passgo terse askme' ;;
    esac
}
field_label() {
    case "$1" in
        color) [ "$LANG_JA" -eq 1 ] && printf 'カラー表示' || printf 'Color' ;;
        idscrl) [ "$LANG_JA" -eq 1 ] && printf '識別の巻物' || printf 'Identify scroll' ;;
        terse) [ "$LANG_JA" -eq 1 ] && printf '表示の長さ' || printf 'Message length' ;;
        passgo) [ "$LANG_JA" -eq 1 ] && printf '曲がり角' || printf 'Corners' ;;
        jump) [ "$LANG_JA" -eq 1 ] && printf 'ジャンプ' || printf 'Jump' ;;
        askme) [ "$LANG_JA" -eq 1 ] && printf '未識別品の確認' || printf 'Unidentified items' ;;
        mapchars) [ "$LANG_JA" -eq 1 ] && printf 'マップ文字' || printf 'Map characters' ;;
        commands) [ "$LANG_JA" -eq 1 ] && printf 'キー操作' || printf 'Key bindings' ;;
        macro) [ "$LANG_JA" -eq 1 ] && printf 'マクロ' || printf 'Macro' ;;
    esac
}
display_setting_value() {
    if [ "$LANG_JA" -eq 1 ]; then printf '%s' "$1"; return 0; fi
    case "$1" in
        モダン) printf Modern ;; クラシック) printf Classic ;;
        '細かく設定') printf Custom ;; カラー) printf Color ;;
        モノクロ) printf Monochrome ;; '１種類') printf '1 kind' ;;
        '５種類') printf '5 kinds' ;; '短くする') printf Short ;;
        ふつう) printf Normal ;; 止まらない) printf 'Do not stop' ;;
        止まる) printf Stop ;; 拡張) printf Extended ;;
        基本) printf Basic ;; '5.4風') printf 'Rogue 5.4-style' ;;
        'DOS 1.48風') printf 'DOS 1.48-style' ;;
        *) printf '%s' "$1" ;;
    esac
}
# Keep the AppleScript preference values as True/False internally, but
# present jump/askme in Japanese as 有効/無効.  Do not translate arbitrary
# strings: a player name, fruit, or macro may legitimately be "True".
display_field_value() {
    case "$1:$LANG_JA:$2" in
        jump:1:True|askme:1:True) printf '有効' ;;
        jump:1:False|askme:1:False) printf '無効' ;;
        *) display_setting_value "$2" ;;
    esac
}
field_value() {
    # The editing UI displays a sanitized macro; saved preferences retain
    # their original value, so this is intentionally display-only.
    if [ "$1" = macro ]; then
        clean_text "$S_MACRO"
    else
        game_setting_value "$1"
    fi
}
field_options() {
    case "$1" in
        color) printf '%s\n' カラー モノクロ ;;
        idscrl) printf '%s\n' '１種類' '５種類' ;;
        terse) printf '%s\n' ふつう 短くする ;;
        passgo) printf '%s\n' 止まらない 止まる ;;
        jump|askme) printf '%s\n' True False ;;
        mapchars) printf '%s\n' 拡張 基本 ;;
        commands) printf '%s\n' '5.4風' 'DOS 1.48風' ;;
    esac
}
assign_field() {
    case "$1" in
        color) S_COLOR=$2 ;; idscrl) S_IDSCRL=$2 ;; terse) S_TERSE=$2 ;;
        passgo) S_PASSGO=$2 ;; jump) S_JUMP=$2 ;; askme) S_ASKME=$2 ;;
        mapchars) S_MAPCHARS=$2 ;; commands) S_COMMANDS=$2 ;;
        macro) S_MACRO=$2 ;;
    esac
}
edit_game_field() {
    field=$1
    clear_screen
    printf '%s%s  %s%s\n' "$TITLE" "$GAME_TITLE" "$(field_label "$field")" "$RST"
    if [ "$field" = macro ]; then
        if [ "$LANG_JA" -eq 1 ]; then printf '\n現在の設定：%s\n' "$(clean_text "$S_MACRO")"; else printf '\nCurrent setting: %s\n' "$(clean_text "$S_MACRO")"; fi
        read_named_text value || return 1
        [ -n "$ANSWER" ] || return 0
        if ! advanced_validate_text macro "$ANSWER"; then advanced_bad_text; return 0; fi
        assign_field macro "$ANSWER"
    else
        if [ "$LANG_JA" -eq 1 ]; then printf '\n現在の設定：%s\n\n' "$(display_field_value "$field" "$(field_value "$field")")"; else printf '\nCurrent setting: %s\n\n' "$(display_field_value "$field" "$(field_value "$field")")"; fi
        n=1
        field_options "$field" | while IFS= read -r v; do
            printf '  %s%s%s  %s\n' "$GOLD" "$n" "$RST" "$(display_field_value "$field" "$v")"
            n=$((n+1))
        done
        if [ "$LANG_JA" -eq 1 ]; then printf '\n%s' '選択（空欄でキャンセル）› '; else printf '\n%s' 'Select (blank cancels) › '; fi
        read_selection || return 1
        case "$ANSWER" in 1|2) : ;; *) return 0 ;; esac
        selected=$(field_options "$field" | sed -n "${ANSWER}p")
        assign_field "$field" "$selected"
    fi
    S_MODE='細かく設定'
    if ! save_game_settings; then wait_for_return || :; return 1; fi
    return 0
}
choose_game_mode() {
    clear_screen
    menu_heading "$GAME_TITLE"
    printf '\n'
    printf '%s\n' '  1  モダン / Modern' '  2  クラシック / Classic' '  3  細かく設定 / Custom'
    if [ "$LANG_JA" -eq 1 ]; then printf '\n%s' '選択（空欄でキャンセル）› '; else printf '\n%s' 'Select (blank cancels) › '; fi
    read_selection || return 1
    case "$ANSWER" in 1) S_MODE=モダン ;; 2) S_MODE=クラシック ;; 3) S_MODE=細かく設定 ;; *) return 0 ;; esac
    apply_mode_preset
    save_game_settings || return 1
}
choose_setting_version() {
    clear_screen
    list_versions
    if [ "$LANG_JA" -eq 1 ]; then printf '\n%s' '設定するバージョン（空欄でキャンセル）› '; else printf '\n%s' 'Choose version (blank cancels) › '; fi
    read_selection || return 1
    [ -n "$ANSWER" ] || return 0
    if resolve_version "$ANSWER"; then
        load_game_settings
        apply_ui_language "$S_LANGUAGE"
    fi
}
# All ROGUEOPTS options — stage 2: game launch applies saved choices.
# Existing AppleScript options are READ/WRITTEN through their ORIGINAL keys.
# Additional options have new keys in the SAME com.leopard.rogue domain.
# The former com.leopard.rogue.cui domain is never used or modified here.
# Saved additional options affect new games; resume still uses language only.
advanced_option_keys() {
    case "$GAME_ID" in
        54) printf '%s' 'color cursor seefloor terse flush jump passgo tombstone inven idscrl name fruit language file' ;;
        clone) printf '%s' 'color cursor jump passgo noaskquit noskull name fruit language file' ;;
        dos) printf '%s' 'color cursor extchars terse jump doskeys menu macro name fruit language file' ;;
        36) printf '%s' 'terse flush jump step askme name fruit language file' ;;
        34) printf '%s' 'terse flush jump step askme name fruit language file' ;;
        52) printf '%s' 'color cursor terse flush jump step askme passgo name fruit language file' ;;
    esac
}
advanced_shared_target() {
    # A nonempty result means this option already belongs to the GUI profile.
    # Do not create an additional state/key for it.
    case "$1" in
        name|fruit) printf 'profile:%s' "$1"; return ;;
        language) printf 'language'; return ;;
    esac
    case "$GAME_ID:$1" in
