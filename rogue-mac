        menu_key_choice M "$(if [ "$LANG_JA" -eq 1 ]; then printf 'モードを変更'; else printf 'Change mode'; fi)"
        menu_key_choice L "$(if [ "$LANG_JA" -eq 1 ]; then printf '表示言語を変更'; else printf 'Change language'; fi)"
        menu_key_choice A "$(if [ "$LANG_JA" -eq 1 ]; then printf '詳細設定'; else printf 'More Options…'; fi)"
        menu_key_choice V "$(if [ "$LANG_JA" -eq 1 ]; then printf 'バージョンを変更'; else printf 'Choose version'; fi)"
        menu_key_choice B "$(if [ "$LANG_JA" -eq 1 ]; then printf 'メインメニューへ戻る'; else printf 'Back to menu'; fi)"
        printf '\n'
        if [ "$LANG_JA" -eq 1 ]; then label='選択'; else label='Select'; fi
        printf '%s%s › %s' "$TITLE" "$label" "$TEXT"
        read_selection || return 0
        case "$ANSWER" in
            [bB]|[qQ]) return 0 ;;
            [mM])
                if ! choose_game_mode; then
                    wait_for_return || :
                    load_game_settings
                fi ;;
            [lL])
                if [ "$S_LANGUAGE" = English ]; then S_LANGUAGE='日本語'; else S_LANGUAGE=English; fi
                if ! save_language_change; then
                    wait_for_return || :
                    load_game_settings
                    apply_ui_language "$S_LANGUAGE"
                fi
                ;;
            [aA]) show_advanced_settings || :; load_game_settings; apply_ui_language "$S_LANGUAGE" ;;
            [vV]) choose_setting_version || : ;;
            [1-9])
                n=1; chosen=''
                for field in $fields; do
                    if [ "$ANSWER" = "$n" ]; then chosen=$field; break; fi
                    n=$((n+1))
                done
                [ -z "$chosen" ] || edit_game_field "$chosen" || :
                ;;
        esac
    done
}

# The saved values are shared with the GUI. A missing player name falls back
# to the macOS full name, but merely reading it does not overwrite GUI settings.
system_player_name() {
    full_name=$(id -F 2>/dev/null || :)
    if [ -n "$full_name" ]; then
        printf '%s' "$full_name"
    else
        id -un 2>/dev/null || printf '%s' 'player'
    fi
}

load_profile() {
    # Read the GUI's profile through the same fallback helper used by
    # version settings. Reading never writes implicit defaults to the store.
    saved_name=$(read_pref Savedmyname '')
    saved_fruit=$(read_pref Savedmyfruit '')
    if [ -n "$saved_name" ]; then
        PLAYER_NAME=$saved_name
    else
        PLAYER_NAME=$(system_player_name)
    fi
    if [ -n "$saved_fruit" ]; then
        PLAYER_FRUIT=$saved_fruit
    elif [ "$LANG_JA" -eq 1 ]; then
        PLAYER_FRUIT='ネバネバかび'
    else
        PLAYER_FRUIT='slime-mold'
    fi
    # GUI startup also reads name/fruit from the login shell once.  Keep the
    # user's subsequent menu edits authoritative for this launcher session.
    if [ "$PROFILE_EDITED" -eq 0 ]; then
        ex_p_remaining=$EXTERNAL_INITIAL_ROGUEOPTS
        while next_rogueopts_item "$ex_p_remaining"; do
            ex_p_remaining=$ROGUEOPTS_REST
            ex_p_item=$ROGUEOPTS_ITEM
            ex_p_key=$(external_option_key "$ex_p_item")
            ex_p_value=$(external_option_value "$ex_p_item")
            case "$ex_p_key" in
                name) if [ -n "$ex_p_value" ] && valid_profile_value "$ex_p_value"; then PLAYER_NAME=$ex_p_value; fi ;;
                fruit) if [ -n "$ex_p_value" ] && valid_profile_value "$ex_p_value"; then PLAYER_FRUIT=$ex_p_value; fi ;;
            esac
        done
    fi
}

write_profile_value() {
    if [ -z "$DEFAULTS_CMD" ]; then
        if [ "$LANG_JA" -eq 1 ]; then
            printf '%s\n' 'macOSのdefaultsコマンドが見つかりません。' >&2
        else
            printf '%s\n' 'The macOS defaults command was not found.' >&2
        fi
        return 1
    fi
    if ! "$DEFAULTS_CMD" write "$DEFAULTS_DOMAIN" "$1" -string "$2"; then
        if [ "$LANG_JA" -eq 1 ]; then
            printf '%s\n' '共有設定の保存に失敗しました。' >&2
        else
            printf '%s\n' 'Unable to write the shared preferences.' >&2
        fi
        return 1
    fi
    case "$1" in Savedmyname|Savedmyfruit) PROFILE_EDITED=1 ;; esac
    return 0
}

# ROGUEOPTS is comma-delimited in all six games. Reject commas and line
# breaks in newly entered values instead of writing settings the games cannot
# interpret. Older GUI values are never changed implicitly.
valid_profile_value() {
    case "$1" in
        ''|*,*|*'
'*) return 1 ;;
        *) return 0 ;;
    esac
}

profile_error() {
    if [ "$LANG_JA" -eq 1 ]; then
        printf '%s\n' '空欄・カンマ・改行を含む設定は使用できません。'
    else
        printf '%s\n' 'The value must be nonempty and contain no commas or newlines.'
    fi
}

show_profile_menu() {
    while :; do
        load_profile
        clear_screen
        if [ "$LANG_JA" -eq 1 ]; then
            menu_heading 'プレイヤー情報の設定'
            printf '%s\n' '──────────────────────────────────────'
            printf 'プレイヤー名：%s\n好きな果物：%s\n\n' "$(clean_text "$PLAYER_NAME")" "$(clean_text "$PLAYER_FRUIT")"
            printf '%s\n' '1. プレイヤー名を変更' '2. 好きな果物を変更' \
                '3. プレイヤー名を初期値に戻す' '4. 好きな果物を初期値に戻す' '' \
                'B. メインメニューに戻る'
            printf '\n%s' '選択: '
        else
            menu_heading 'Player settings'
            printf '%s\n' '──────────────────────────────────────'
            printf 'Player name: %s\nFavorite fruit: %s\n\n' "$(clean_text "$PLAYER_NAME")" "$(clean_text "$PLAYER_FRUIT")"
            printf '%s\n' '1. Change player name' '2. Change favorite fruit' \
                '3. Reset player name' '4. Reset favorite fruit' '' \
                'B. Back to main menu'
            printf '\n%s' 'Select: '
        fi
        read_selection || return 0
        case "$ANSWER" in
            1|2)
                which=$ANSWER
                if [ "$which" = 1 ]; then
                    read_named_text name || return 0
                else
                    read_named_text fruit || return 0
                fi
                [ -n "$ANSWER" ] || continue
                if ! valid_profile_value "$ANSWER"; then
                    profile_error
                    wait_for_return || return 0
                    continue
                fi
                if [ "$which" = 1 ]; then
                    write_profile_value Savedmyname "$ANSWER" || wait_for_return || return 0
                else
                    write_profile_value Savedmyfruit "$ANSWER" || wait_for_return || return 0
                fi
                ;;
            3)
                reset_name=$(system_player_name)
                write_profile_value Savedmyname "$reset_name" || wait_for_return || return 0
                ;;
            4)
                if [ "$LANG_JA" -eq 1 ]; then
                    reset_fruit='ネバネバかび'
                else
                    reset_fruit='slime-mold'
                fi
                write_profile_value Savedmyfruit "$reset_fruit" || wait_for_return || return 0
                ;;
            [bB]|[qQ]) return 0 ;;
        esac
    done
}

# Draw all version entries from setup_game(), the authoritative metadata map.
# Run in a subshell so the display never changes the caller's GAME_ID, paths,
# or settings prefix. The guide menu never reads save preferences.
version_title_for() (
    GAME_ID=$1
    setup_game || exit 1
    printf '%s' "$GAME_TITLE"
)
show_version_entries() (
    entry_mode=$1
    idx=1
    for id in 54 clone dos 36 52 34; do
        GAME_ID=$id
        setup_game || exit 1
        version=$GAME_TITLE
        status=''
        if [ "$entry_mode" = saves ]; then
            # Use the same custom file= preference as the actual launch path.
            configured_save_file
            savepath=$(configured_save_path)
            if [ -f "$savepath" ]; then
                if [ "$LANG_JA" -eq 1 ]; then status='セーブあり'; else status='Saved'; fi
            fi
        fi
        version_color=$TEXT
        if [ "$id" = "$LAST_ID" ]; then
            # Only the version name is highlighted, not the save status.
            version_color=$DIM
        fi
        printf '  %s%2s%s  %s%-21s%s' "$GOLD" "$idx" "$RST" "$version_color" "$version" "$RST"
        [ -z "$status" ] || printf ' %s%s%s' "$SAVE_COLOR" "$status" "$RST"
        printf '\n'
        idx=$((idx+1))
    done
)

show_main_menu() {
    load_last_version
    load_ui_language
    LAST_TITLE=$(version_title_for "$LAST_ID")
    load_profile
    clear_screen
    printf '%s╭' "$GOLD"; line52; printf '╮%s\n' "$RST"
    printf '%s│%19s%-33s│%s\n' "$GOLD" '' 'Rogue for macOS' "$RST"
    printf '%s╰' "$GOLD"; line52; printf '╯%s\n' "$RST"
    player=$(clean_text "$PLAYER_NAME")
    fruit=$(clean_text "$PLAYER_FRUIT")
    if [ "$LANG_JA" -eq 1 ]; then
        printf '\n  %sやあ、%s。運命の洞窟へようこそ・・・%s\n' "$TEXT" "$player" "$RST"
        printf '\n%s   好きな果物:%s %s%s\n' "$DIM" "$TEXT" "$fruit" "$RST"
    else
        printf '\n  %sHello, %s. Welcome to the Dungeons of Doom...%s\n' "$TEXT" "$player" "$RST"
        printf '\n%s   Favorite fruit:%s %s%s\n' "$DIM" "$TEXT" "$fruit" "$RST"
    fi
    printf '\n%s' "$DIM"; line52; printf '%s\n\n' "$RST"
    show_version_entries saves
    printf '\n%s' "$DIM"; line52; printf '%s\n' "$RST"
    if [ "$LANG_JA" -eq 1 ]; then
        # G and Q share the same column; the first Japanese line is 52 cells wide.
        printf '   %sP%s  プレイヤー情報     %sG%s  【運命の洞窟】への案内書\n' "$GOLD" "$TEXT" "$GOLD" "$TEXT"
        printf '   %sS%s  ゲーム設定         %sQ%s  終了\n\n' "$GOLD" "$TEXT" "$GOLD" "$TEXT"
        printf '  %sReturn：前回選択した %s を起動%s\n' "$DIM" "$LAST_TITLE" "$RST"
        printf '  %s冒険したいバージョンまたは操作を選ぶ › %s' "$TITLE" "$TEXT"
    else
        printf '   %sP%s  Player settings    %sG%s  Guidebook\n' "$GOLD" "$TEXT" "$GOLD" "$TEXT"
        printf '   %sS%s  Game settings      %sQ%s  Quit\n\n' "$GOLD" "$TEXT" "$GOLD" "$TEXT"
        printf '  %sReturn: launch previously selected %s%s\n' "$DIM" "$LAST_TITLE" "$RST"
        printf '  %sChoose a version or action › %s' "$TITLE" "$TEXT"
    fi
}

# Use exactly the same version-specific URLs as the AppleScript GUI.
# No user input is interpolated into the URL.
guide_url_for_version() {
    case "$1" in
        54)    printf '%s' 'https://leopard-gecko.github.io/jrogue/guide.html?version=54' ;;
        clone) printf '%s' 'https://leopard-gecko.github.io/jrogue/guide.html?version=clone3' ;;
        dos)   printf '%s' 'https://leopard-gecko.github.io/jrogue/guide.html?version=dos148' ;;
        36)    printf '%s' 'https://leopard-gecko.github.io/jrogue/guide.html?version=36' ;;
        52)    printf '%s' 'https://leopard-gecko.github.io/jrogue/guide.html?version=52' ;;
        34)    printf '%s' 'https://leopard-gecko.github.io/jrogue/guide.html?version=34' ;;
        *) return 1 ;;
    esac
}

show_guide_menu() {
    while :; do
        # Follow the GUI's last selection but never change it by viewing guides.
        load_last_version
        load_ui_language
        LAST_TITLE=$(version_title_for "$LAST_ID")
        clear_screen
        if [ "$LANG_JA" -eq 1 ]; then
            menu_heading '【運命の洞窟】への案内書'
        else
            menu_heading 'A Guide to the Dungeons of Doom'
        fi
        printf '%s' "$DIM"; line52; printf '%s\n\n' "$RST"
        show_version_entries guides
        printf '\n  %sB%s  %s\n\n' "$GOLD" "$RST" "$(if [ "$LANG_JA" -eq 1 ]; then printf 'メインメニューへ戻る'; else printf 'Back to main menu'; fi)"
        if [ "$LANG_JA" -eq 1 ]; then
            printf '  %sReturn：%sの案内書を開く%s\n' "$DIM" "$LAST_TITLE" "$RST"
            printf '  %s案内書を選ぶ › %s' "$TITLE" "$TEXT"
        else
            printf '  %sReturn: open guide for %s%s\n' "$DIM" "$LAST_TITLE" "$RST"
            printf '  %sChoose a guide › %s' "$TITLE" "$TEXT"
        fi
        read_selection || return 0
        case "$ANSWER" in
            [bB]|[qQ]) return 0 ;;
            '') guide_id=$LAST_ID ;;
            1|2|3|4|5|6)
                if ! resolve_version "$ANSWER"; then continue; fi
                guide_id=$GAME_ID ;;
            *) continue ;;
        esac
        url=$(guide_url_for_version "$guide_id") || continue
        # macOS's `open` invokes the default browser; leave the launcher running.
        # On failure, report the error and keep the guide menu available.
        if command -v open >/dev/null 2>&1 && open "$url"; then
            return 0
        fi
        if [ "$LANG_JA" -eq 1 ]; then
            printf '\n%s\n' '案内書を開けませんでした。macOSのブラウザ設定をご確認ください。'
        else
            printf '\n%s\n' 'Could not open the guide. Check your macOS browser settings.'
        fi
        wait_for_return || return 0
    done
}

missing_game() {
    if [ "$LANG_JA" -eq 1 ]; then
        printf '\n%s はインストールされていません。\n' "$GAME_TITLE"
        printf 'インストール: brew install %s\n' "$GAME_BIN"
    else
        printf '\n%s is not installed.\n' "$GAME_TITLE"
        printf 'Install it with: brew install %s\n' "$GAME_BIN"
    fi
    wait_for_return
}

wait_for_return() {
    if [ "$LANG_JA" -eq 1 ]; then
        printf '\n%s' 'リターンを押してください: '
    else
        printf '\n%s' 'Press Return to continue: '
    fi
    read_selection || return 1
}

choose_saved_game() {
    # Sets START_MODE and START_PATH without changing any saved file.
    # Return 1 to go back to the version menu.
    START_MODE=new
    START_PATH=
    if [ ! -f "$(configured_save_path)" ]; then
        return 0
    fi
    while :; do
        clear_screen
        printf '%s\n' "$GAME_TITLE"
        if [ "$LANG_JA" -eq 1 ]; then
            printf '%s\n' '保存した冒険が見つかりました。' "$SAVE_FILE" ''
            printf '%s\n' 'R / Enter  セーブから再開' 'N          新しい冒険を始める' \
                'F          別のセーブファイルを指定' 'Q          バージョン選択に戻る'
            printf '\n%s' '選択: '
        else
            printf '%s\n' 'Saved game found:' "$SAVE_FILE" ''
            printf '%s\n' 'R / Enter  Resume saved game' 'N          New adventure' \
                'F          Choose another saved file' 'Q          Back to version menu'
            printf '\n%s' 'Select: '
        fi
        read_selection || return 1
        case "$ANSWER" in
            ''|[rR]) START_MODE=resume; START_PATH=$(configured_save_path); return 0 ;;
            [nN]) START_MODE=new; START_PATH=; return 0 ;;
            [fF]) choose_another_file && return 0 ;;
            [qQ]) return 1 ;;
            *) : ;;
        esac
    done
}

choose_another_file() {
    printf '\n'
    read_named_text path || return 1
    [ -n "$ANSWER" ] || return 1
    case "$ANSWER" in
        '~')       path=$HOME ;;
        '~/'*)     path=$HOME/${ANSWER#'~/'} ;;
        /*)        path=$ANSWER ;;
        *)         path=$GAME_DIR/$ANSWER ;;
    esac
    if [ ! -f "$path" ]; then
        if [ "$LANG_JA" -eq 1 ]; then
            printf 'ファイルが見つかりません: %s\n' "$path"
        else
            printf 'File not found: %s\n' "$path"
        fi
        wait_for_return || return 1
        return 1
    fi
    START_MODE=resume
    START_PATH=$path
    return 0
}

# Compose new-game-only options without executing or evaluating profile text.
# When creating a new game, GUI settings replace the keys they control.
# Other inherited ROGUEOPTS keys are passed through unchanged.
append_game_option() {
    [ -n "$1" ] || return 0
    if [ -z "$GAME_ROGUEOPTS" ]; then
        GAME_ROGUEOPTS=$1
    else
        GAME_ROGUEOPTS=$GAME_ROGUEOPTS,$1
    fi
}

without_profile_options() {
    # Keep the caller's leading language= token so that localized option
    # values (notably 5.4 inven=) are interpreted in the correct language.
    remaining=$EXTERNAL_ROGUEOPTS
    while next_rogueopts_item "$remaining"; do
        remaining=$ROGUEOPTS_REST
        item=$ROGUEOPTS_ITEM
        [ -n "$item" ] || continue
        case "$item" in *'
'*|*'
'*) continue ;; esac
        opt=$(external_option_key "$item")
        # `file` would disagree with the standard saved-game detection.
        case "$opt" in file|name|fruit|language) continue ;; esac
        # The GUI supplies these values; do not send contradictory tokens.
        [ -z "$(advanced_shared_target "$opt")" ] || continue
        # As with other additional options, an explicit 5.2 Jump choice
        # overrides the login shell. Without a saved choice, pass the
        # login-shell jump/nojump token through unchanged.
        # The GUI's SavedVersion52_myjump is deliberately not consulted.
        # A user's explicit detailed-menu selection overrides the login shell.
        case "$GAME_ID:$opt" in
            clone:noskull|clone:notomb) extra_override=$(advanced_pref_read noskull) ;;
            *) extra_override=$(advanced_pref_read "$opt") ;;
        esac
        [ "$extra_override" = inherit ] || continue
        case "$GAME_ID:$opt" in
            54:cursor|clone:cursor|dos:cursor|52:cursor) continue ;;
            54:inven)
                # 5.4's parser matches `inven=` against the *localized*
                # inventory-style names.  A user's external ROGUEOPTS may
                # use English names while the game is launched in Japanese
                # (or vice versa).  Normalize known values to the selected
                # language; keep an unrecognized value intact for the game.
                ext_inv_mode=$(inventory_mode_from_value "$(external_option_value "$item")")
                if [ -n "$ext_inv_mode" ]; then
                    append_game_option "inven=$(inventory_mode_for_game "$ext_inv_mode")"
                    continue
                fi ;;
        esac
        append_game_option "$item"
    done
}

# Append only explicitly selected extra settings; the unchanged external
# options (when no choice is saved) were already included by the caller.
# Keep the game's original parser grammar, including Clone III one-way flags.
append_additional_game_options() {
    for add_opt in $(advanced_option_keys); do
        [ -z "$(advanced_shared_target "$add_opt")" ] || continue
        add_state=$(advanced_pref_read "$add_opt")
        [ "$add_state" != inherit ] || continue
        case "$add_opt:$add_state" in
            file:custom)
                add_value=$(advanced_text file)
                if advanced_validate_text file "$add_value"; then
                    append_game_option "file=$add_value"
                fi ;;
            file:*) : ;;
            inven:Overwrite|inven:Slow|inven:Clear)
                append_game_option "inven=$(inventory_mode_for_game "$add_state")" ;;
            menu:on|menu:sel|menu:off) append_game_option "menu=$add_state" ;;
            noaskquit:off) append_game_option noaskquit ;;
            noskull:off) append_game_option noskull ;;
            noaskquit:on|noskull:on) : ;;
            jump:off)
                # Clone III does not recognize `nojump`, so for that version
                # removing any external `jump` leaves modern build's default.
                if [ "$GAME_ID" != clone ]; then append_game_option nojump; fi ;;
            *:on) append_game_option "$add_opt" ;;
            *:off) append_game_option "no$add_opt" ;;
        esac
    done
}

# Reuse the same configured path for saved-game detection and the file= token.
# The path is never evaluated as shell code, and only explicitly stored
# choices affect it (external file= remains excluded as before).
configured_save_file() {
    save_mode=$(advanced_pref_read file)
    [ "$save_mode" = custom ] || return 0
    save_value=$(advanced_text file)
    advanced_validate_text file "$save_value" || return 0
    case "$save_value" in
        '~/'*) SAVE_FILE=$HOME/${save_value#'~/'} ;;
        /*) SAVE_FILE=$save_value ;;
        *) SAVE_FILE=$save_value ;;
    esac
}
configured_save_path() {
    case "$SAVE_FILE" in
        /*) printf '%s' "$SAVE_FILE" ;;
        *) printf '%s/%s' "$GAME_DIR" "$SAVE_FILE" ;;
    esac
}

new_game_options() {
    load_game_settings
    # Fruit fallback follows the selected game's language, not the language
    # of the main menu (which may show a different last-played version).
    apply_ui_language "$S_LANGUAGE"
    load_profile
    GAME_ROGUEOPTS=''
    # The 5.4 inventory styles are localized.  Set language before reading
    # externally specified inventory styles or composing launcher settings.
    if [ "$S_LANGUAGE" = English ]; then append_game_option language=en; else append_game_option language=ja; fi
    without_profile_options
    case "$S_COLOR" in
        カラー) display_color='color,nocursor' ;;
        *) if [ "$GAME_ID" = dos ] && [ "$S_MAPCHARS" = 拡張 ]; then
            display_color='nocolor,nocursor'
           else display_color='nocolor,cursor'; fi ;;
    esac
    case "$S_TERSE" in 短くする) terse_opt=terse ;; *) terse_opt=noterse ;; esac
    case "$S_PASSGO" in 止まらない) passgo_opt=passgo ;; *) passgo_opt=nopassgo ;; esac
    case "$S_IDSCRL" in '１種類') idscrl_opt=idscrl ;; *) idscrl_opt=noidscrl ;; esac
    case "$S_MAPCHARS" in 拡張) map_opt=extchars ;; *) map_opt=noextchars ;; esac
    case "$GAME_ID" in
        54)
            append_game_option "$display_color"
            append_game_option "$idscrl_opt"
            append_game_option "$terse_opt"
            append_game_option "$passgo_opt" ;;
        clone)
            append_game_option "$display_color"
            append_game_option "$passgo_opt"
            [ "$S_JUMP" != True ] || append_game_option jump ;;
        dos)
            append_game_option "$display_color"
            append_game_option "$map_opt"
            [ "$S_COMMANDS" != '5.4風' ] || append_game_option nodoskeys
            if advanced_validate_text macro "$S_MACRO"; then append_game_option "macro=$S_MACRO"; else append_game_option 'macro=v'; fi
            append_game_option "$terse_opt" ;;
        36|34)
            [ "$S_JUMP" != True ] || append_game_option jump
            if [ "$S_ASKME" = True ]; then append_game_option askme; else append_game_option noaskme; fi
            append_game_option "$terse_opt" ;;
        52)
            append_game_option "$display_color"
            # No forced jump/nojump from the mode preset. The detailed-menu
            # on/off choice (if saved) is appended below; otherwise an external
            # login-shell token, or the game's own default, takes precedence.
            append_game_option "$passgo_opt"
            if [ "$S_ASKME" = True ]; then append_game_option askme; else append_game_option noaskme; fi
            append_game_option "$terse_opt" ;;
    esac
    append_additional_game_options
    if valid_profile_value "$PLAYER_FRUIT"; then append_game_option "fruit=$PLAYER_FRUIT"; fi
    if valid_profile_value "$PLAYER_NAME"; then append_game_option "name=$PLAYER_NAME"; fi
}

# Keep the three launch modes in one place.  Only this subshell changes cwd
# or exports game-specific ROGUEOPTS, so nothing leaks into the launcher menu.
# Explicit arguments are never rewritten; resuming passes exactly the path
# selected by the user; a new game receives no positional arguments.
launch_game_process() (
    cd "$GAME_DIR" || exit 1
    if [ "$#" -gt 0 ]; then
        ROGUEOPTS=$EXTERNAL_ROGUEOPTS
    elif [ "$START_MODE" = resume ]; then
        # The saved character's name and fruit must not be replaced.
        load_game_settings
        GAME_ROGUEOPTS=''
        if [ "$S_LANGUAGE" = English ]; then append_game_option language=en; else append_game_option language=ja; fi
        ROGUEOPTS=$GAME_ROGUEOPTS
        set -- "$START_PATH"
    else
        # New adventures use the GUI-shared profile and additional options.
        new_game_options
        ROGUEOPTS=$GAME_ROGUEOPTS
    fi
    export ROGUEOPTS
    "$GAME_BIN" "$@"
)

report_directory_error() {
    if [ "$LANG_JA" -eq 1 ]; then
        printf 'ゲーム用ディレクトリを利用できません: %s\n' "$GAME_DIR" >&2
    else
        printf 'Unable to access game directory: %s\n' "$GAME_DIR" >&2
    fi
}
# Both the pre-save chooser and the actual launch validate the directory:
# the second check also catches changes that occur after save selection.
ensure_game_directory() {
    if ! mkdir -p "$GAME_DIR" || ! (cd "$GAME_DIR") 2>/dev/null; then
        report_directory_error
        wait_for_return || :
        return 1
    fi
    return 0
}
# Return 3 only if no game was started (not a Rogue process exit code).
run_selected_game() {
    ensure_game_directory || return 3
    if ! command -v "$GAME_BIN" >/dev/null 2>&1; then
        missing_game || :
        return 3
    fi
    # Refresh the login-shell environment immediately before each launch.
    EXTERNAL_ROGUEOPTS=$(read_external_rogueopts)
    clear_terminal_screen
    launch_game_process "$@"
    result=$?
    if [ "$result" -ne 0 ]; then
        if [ "$LANG_JA" -eq 1 ]; then
            printf '\nゲームが終了しました（終了コード: %s）。\n' "$result"
        else
            printf '\nGame exited with status %s.\n' "$result"
        fi
    fi
    # Keep the post-score-screen pause for 3.4, 3.6 and 5.2.
    if [ "$GAME_ID" = 36 ] || [ "$GAME_ID" = 52 ] || [ "$GAME_ID" = 34 ]; then
        if [ -t 1 ]; then
            printf '\033[24;1H\033[2K'
        fi
        wait_for_return || return 1
    fi
    return 0
}

post_game_menu() {
    while :; do
        # Remove Rogue's last curses colors and draw the black menu surface.
        clear_screen
        printf '\n'
        if [ "$LANG_JA" -eq 1 ]; then
            printf '%s\n' 'もう一度遊びますか？' \
                '  Y. 同じバージョンでもう一度' \
                '  M. バージョン選択に戻る' \
                '  N. 終了'
            printf '%s' '選択: '
        else
            printf '%s\n' 'Play again?' \
                '  Y. Same version again' \
                '  M. Version menu' \
                '  N. Quit'
            printf '%s' 'Select: '
        fi
        read_selection || return 2
        case "$ANSWER" in
            [yY]) return 0 ;;
            [mM]) return 1 ;;
            [nN]|[qQ]) return 2 ;;
        esac
    done
}

# A normal launch always rechecks the configured save on every new round;
# explicit CLI arguments bypass this chooser for the first round only.
prepare_interactive_launch() {
    ensure_game_directory || return 1
    configured_save_file
    choose_saved_game
}

play_version() {
    setup_game || return 1
    if [ ! -t 0 ]; then
        # Avoid launching an interactive curses game from a pipe.
        if [ "$LANG_JA" -eq 1 ]; then
            printf '%s\n' '対話式ランチャーにはターミナルが必要です。' >&2
        else
            printf '%s\n' 'An interactive terminal is required.' >&2
        fi
        return 2
    fi
    if ! command -v "$GAME_BIN" >/dev/null 2>&1; then
        missing_game || :
        return 1
    fi
    if ! remember_version; then
        # Do not lose the persistent-write warning on the next repaint.
        wait_for_return || :
        return 1
    fi
    launch_with_args=0
    [ "$#" -eq 0 ] || launch_with_args=1
    while :; do
        if [ "$launch_with_args" -eq 1 ]; then
            START_MODE=new
            START_PATH=
            run_selected_game "$@"
            run_status=$?
            [ "$run_status" -ne 3 ] || return 1
            # Y after this round must use the ordinary saved-game chooser.
            launch_with_args=0
            set --
        else
            prepare_interactive_launch || return 1
            run_selected_game
            run_status=$?
            [ "$run_status" -ne 3 ] || return 1
        fi
        post_game_menu
        case "$?" in
            0) : ;; # Y: recheck the selected version's saved game
            1) return 1 ;; # M: version menu
            2) return 2 ;; # N: quit
        esac
    done
}

# Match the AppleScript GUI's goodbyeMessage() in both languages.
goodbye_message() {
    # Restore the Terminal profile and clear before displaying the farewell.
    clear_terminal_screen
    if [ "$LANG_JA" -eq 1 ]; then
        printf 'それでは、またね。\n'
    else
        printf 'See you again.\n'
    fi
}

# The main menu has one dispatcher for both Return and a numbered choice.
# Return status 2 requests a farewell; every other result redraws the menu.
# Child menus do not change the main-menu exit policy.
handle_main_selection() {
    case "$1" in
        [qQ]) return 2 ;;
        [pP]) show_profile_menu; return 0 ;;
        [sS]) show_game_settings; return 0 ;;
        [gG]) show_guide_menu; return 0 ;;
        '') GAME_ID=$LAST_ID ;;
        *) resolve_version "$1" || return 0 ;;
    esac
    play_version
    case "$?" in
        2) return 2 ;;
        *) return 0 ;;
    esac
}

# Both CLI launch and the menu dispatcher enter the same play_version loop;
# its result distinguishes return-to-menu from quit without persistent flags.
main() {
    case "${1:-}" in
        --help|-h) usage; return 0 ;;
        --version) printf 'rogue-mac %s\n' "$VERSION"; return 0 ;;
        --show-rogueopts)
            check_opts=$(read_external_rogueopts)
            if [ -n "$check_opts" ]; then
                printf 'Login-shell ROGUEOPTS: %s\n' "$check_opts"
            else
                printf '%s\n' 'Login-shell ROGUEOPTS: (not set or could not be retrieved)'
            fi
            return 0 ;;
        --list) list_versions; return 0 ;;
        --mono) UI_MONO=1; shift ;;
    esac
    init_colors
    EXTERNAL_INITIAL_ROGUEOPTS=$(read_external_rogueopts)
    EXTERNAL_ROGUEOPTS=$EXTERNAL_INITIAL_ROGUEOPTS
    # SIGINT is normally delivered to both the interactive shell and its
    # foreground child. Always restore colors/remove a pending input file;
    # do not show the normal farewell or restart the menu after a signal.
    trap 'cleanup_launcher' 0
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 131' QUIT
    trap 'exit 143' TERM
    if [ "$#" -gt 0 ]; then
        if ! resolve_version "$1"; then
            printf 'Unknown Rogue version: %s\n' "$1" >&2
            usage >&2
            return 2
        fi
        shift
        play_version "$@"
        direct_result=$?
        case "$direct_result" in
            1) : ;; # M: return to the version menu
            2) goodbye_message; return 0 ;; # N: exit
            *) return "$direct_result" ;;
        esac
    fi
    if [ ! -t 0 ]; then
        printf 'An interactive terminal is required.\n' >&2
        return 2
    fi
    while :; do
        show_main_menu
        read_selection || { goodbye_message; return 0; }
        handle_main_selection "$ANSWER"
        case "$?" in
            2) goodbye_message; return 0 ;;
        esac
    done
}

# Only the UTF-8 editor temporarily changes tty modes. It restores them
# before returning, while the launcher's EXIT trap handles colors and files.
main "$@"
