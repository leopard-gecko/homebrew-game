advanced_reset() {
    clear_screen
    if [ "$LANG_JA" -eq 1 ]; then
        printf '%s%s — 追加設定をリセット%s\n\n' "$TITLE" "$GAME_TITLE" "$RST"
        printf '%s\n' 'このバージョンで個別に保存したオプション指定を解除します。'
        printf '%s\n' 'プレイヤー名・果物・カラーなどの基本設定は変更しません。'
        printf '%s\n' '解除した項目は、ログインシェルのROGUEOPTSに指定があればその値を使い、'
        printf '%s\n' 'なければゲーム本体の初期設定を使います。'
        printf '\n%s' 'リセットしますか？ (Y/N) › '
    else
        printf '%s%s — Reset additional options%s\n\n' "$TITLE" "$GAME_TITLE" "$RST"
        printf '%s\n' 'Remove separately saved option choices for this version.'
        printf '%s\n' 'Player name, fruit, color and other basic settings will stay unchanged.'
        printf '%s\n' 'For cleared options, login-shell ROGUEOPTS is used when specified;'
        printf '%s\n' 'otherwise the game defaults apply.'
        printf '\n%s' 'Reset? (Y/N) › '
    fi
    read_selection || return 1
    case "$ANSWER" in [yY]) : ;; *) return 0 ;; esac
    if [ -z "$DEFAULTS_CMD" ]; then
        if [ "$LANG_JA" -eq 1 ]; then printf '%s\n' 'macOSのdefaultsコマンドが見つかりません。'; else printf '%s\n' 'macOS defaults is unavailable.'; fi
        wait_for_return || :
        return 1
    fi
    adv_rs_failed=0
    for adv_rs_opt in $(advanced_option_keys); do
        [ -z "$(advanced_shared_target "$adv_rs_opt")" ] || continue
        for adv_rs_suffix in '' _value; do
            if [ "$adv_rs_suffix" = _value ] && [ "$(advanced_option_type "$adv_rs_opt")" != text ]; then continue; fi
            adv_rs_key=$(advanced_key "$adv_rs_opt")${adv_rs_suffix}
            if "$DEFAULTS_CMD" read "$DEFAULTS_DOMAIN" "$adv_rs_key" >/dev/null 2>&1; then
                "$DEFAULTS_CMD" delete "$DEFAULTS_DOMAIN" "$adv_rs_key" >/dev/null 2>&1 || adv_rs_failed=1
            fi
        done
    done
    if [ "$adv_rs_failed" -ne 0 ]; then
        if [ "$LANG_JA" -eq 1 ]; then printf '%s\n' '一部の追加設定をリセットできませんでした。'; else printf '%s\n' 'Some individual options could not be reset.'; fi
        wait_for_return || :
        return 1
    fi
}
