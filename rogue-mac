        read_selection || return 0
        case "$ANSWER" in
            [bB]|[qQ]) return 0 ;;
            [rR]) advanced_reset ;;
            *)
                adv_menu_index=1 adv_menu_selected=''
                for adv_menu_opt in $(advanced_option_keys); do
                    if [ "$ANSWER" = "$adv_menu_index" ]; then adv_menu_selected=$adv_menu_opt; break; fi
                    adv_menu_index=$((adv_menu_index+1))
                done
                if [ -n "$adv_menu_selected" ]; then
                    if [ -n "$(advanced_shared_target "$adv_menu_selected")" ]; then
                        # Shared-setting failures have not yet shown a pause;
                        # otherwise the next repaint would hide the warning.
                        advanced_edit_shared "$adv_menu_selected" || { wait_for_return || :; }
