# Return the last applicable login-shell setting for an additional option.
# Empty output means no external setting.  The same scan is used by both
# the detailed UI and the game-environment composer.
advanced_external_mode() {
    ae_requested=$1
    ae_remaining=$EXTERNAL_ROGUEOPTS
    ae_result=''
    while next_rogueopts_item "$ae_remaining"; do
        ae_remaining=$ROGUEOPTS_REST
        ae_item=$ROGUEOPTS_ITEM
        [ -n "$ae_item" ] || continue
        ae_key=$(external_option_key "$ae_item")
        ae_value=$(external_option_value "$ae_item")
        if [ "$ae_requested" = noskull ]; then
            case "$ae_key" in noskull|notomb) ae_result=off ;; esac
        elif [ "$ae_requested" = noaskquit ]; then
            [ "$ae_key" != noaskquit ] || ae_result=off
        elif [ "$ae_requested" = "$ae_key" ]; then
            case "$ae_requested" in
                inven)
                    ae_normalized=$(inventory_mode_from_value "$ae_value")
                    [ -z "$ae_normalized" ] || ae_result=$ae_normalized ;;
                menu)
                    case "$ae_value" in on|sel|off) ae_result=$ae_value ;; esac ;;
                file) : ;; # Preserve the launcher's file detection policy.
                *)
                    if external_option_off "$ae_item"; then ae_result=off; else ae_result=on; fi ;;
            esac
        fi
    done
    printf '%s' "$ae_result"
}
advanced_effective_mode() {
    adv_effective_saved=$(advanced_pref_read "$1")
    if [ "$adv_effective_saved" = inherit ]; then
        # Cursor visibility is already derived from the GUI's color preset.
        # The current launcher intentionally ignores an external cursor token
        # unless the user explicitly chooses a cursor value in More Options.
        if [ "$1" = cursor ]; then
            if [ "$S_COLOR" = カラー ] || { [ "$GAME_ID" = dos ] && [ "$S_MAPCHARS" = 拡張 ]; }; then
                printf off
            else
                printf on
            fi
        else
            adv_effective_shell=$(advanced_external_mode "$1")
            if [ -n "$adv_effective_shell" ]; then
                printf '%s' "$adv_effective_shell"
            else
                advanced_default_mode "$1"
            fi
        fi
