advanced_validate_text() {
    adv_vt_option=$1 adv_vt_input=$2
    valid_profile_value "$adv_vt_input" || return 1
    [ "$(clean_text "$adv_vt_input")" = "$adv_vt_input" ] || return 1
    case "$adv_vt_option" in
        name) adv_vt_max=128 ;; fruit) adv_vt_max=256 ;;
        macro) adv_vt_max=40 ;; file) adv_vt_max=1023 ;;
        *) return 1 ;;
    esac
    adv_vt_bytes=$(printf '%s' "$adv_vt_input" | LC_ALL=C wc -c | tr -d ' ')
    [ "$adv_vt_bytes" -le "$adv_vt_max" ] || return 1
    # DOS Tribute skips the `x` macro trigger to prevent recursion.
    if [ "$adv_vt_option" = macro ]; then
        case "$adv_vt_input" in *x*) return 1 ;; esac
    fi
    if command -v iconv >/dev/null 2>&1; then
        printf '%s' "$adv_vt_input" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || return 1
    fi
    return 0
}
