        if [ "$adv_ed_option" = file ]; then
            if [ "$adv_ed_old" = custom ]; then
                adv_ed_current=$(clean_text "$(advanced_text "$adv_ed_option")")
            else
                adv_ed_current=$SAVE_FILE
            fi
            menu_advanced_current "$adv_ed_current"
        else
            menu_advanced_current "$(advanced_state_label "$adv_ed_option" "$(advanced_effective_mode "$adv_ed_option")")"
        fi
        adv_ed_num=1
        for adv_ed_choice in $(advanced_allowed_modes "$adv_ed_option"); do
            menu_numbered_choice "$adv_ed_num" "$(advanced_choice_label "$adv_ed_option" "$adv_ed_choice")"
            adv_ed_num=$((adv_ed_num+1))
        done
        if [ "$LANG_JA" -eq 1 ]; then printf '\n%s' '番号を選択（Bで戻る）› '; else printf '\n%s' 'Choose number (B to go back) › '; fi
        read_selection || return 1
        case "$ANSWER" in ''|[bB]|[qQ]) return 0 ;; esac
        adv_ed_num=1 adv_ed_selected=''
        for adv_ed_choice in $(advanced_allowed_modes "$adv_ed_option"); do
            if [ "$ANSWER" = "$adv_ed_num" ]; then adv_ed_selected=$adv_ed_choice; break; fi
            adv_ed_num=$((adv_ed_num+1))
        done
        [ -n "$adv_ed_selected" ] || continue
        if [ "$adv_ed_selected" = custom ]; then
            read_named_text value || return 1
            [ -n "$ANSWER" ] || continue
            if ! advanced_validate_text "$adv_ed_option" "$ANSWER"; then advanced_bad_text; continue; fi
            write_profile_value "$(advanced_key "$adv_ed_option")_value" "$ANSWER" || { wait_for_return || :; return 1; }
        fi
        advanced_pref_write "$adv_ed_option" "$adv_ed_selected" || { wait_for_return || :; return 1; }
        return 0
    done
